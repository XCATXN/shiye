{
  "manifest_version": 3,
  "name": "拾页",
  "version": "0.9.0",
  "description": "ChatGPT、Claude、DeepSeek、Gemini 会话数据备份；豆包、Kimi、千问、元宝网页备用导出。支持后台运行、暂停继续、休眠与本机 TXT/JSON 整理。",
  "permissions": [
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "单聊天备份 · 打开侧栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "devtools_page": "devtools.html"
}
